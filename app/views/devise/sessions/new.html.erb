<div class="min-h-screen flex items-center justify-center bg-surface px-4">
  <div class="w-full max-w-sm">

    <div class="text-center mb-6">
      <%= link_to root_path, class: "font-display text-2xl text-primary-900" do %>Linguio<% end %>
      <p class="font-display italic text-ink-secondary mt-1" style="font-size: 15px;">Bon retour.</p>
    </div>

    <div class="bg-white rounded-xl border border-border p-8">

      <div class="flex rounded-lg bg-surface p-1 mb-6">
        <span class="flex-1 text-center rounded-md bg-white border border-border font-semibold py-1.5 text-ink" style="font-size: 13px;">
          Sign in
        </span>
        <%= link_to "Create account", new_user_registration_path,
              class: "flex-1 text-center rounded-md font-semibold py-1.5 text-ink-muted hover:text-ink transition-colors", style: "font-size: 13px;" %>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-4">
          <%= f.label :email, "Email address", class: "block text-ink-muted font-semibold uppercase mb-1.5", style: "font-size: 11px; letter-spacing: 0.06em;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                class: "w-full rounded-xl border border-border px-3 py-2 focus:outline-none focus:border-primary-900" %>
        </div>

        <div class="mb-4" data-controller="password-visibility">
          <%= f.label :password, "Password", class: "block text-ink-muted font-semibold uppercase mb-1.5", style: "font-size: 11px; letter-spacing: 0.06em;" %>
          <div class="relative">
            <%= f.password_field :password, autocomplete: "current-password",
                  data: { password_visibility_target: "input" },
                  class: "w-full rounded-xl border border-border px-3 py-2 pr-14 focus:outline-none focus:border-primary-900" %>
            <button type="button" data-action="password-visibility#toggle"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-primary-900 font-medium" style="font-size: 12px;">
              <span data-password-visibility-target="icon">Show</span>
            </button>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-2 flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-border" %>
            <%= f.label :remember_me, class: "text-ink-secondary", style: "font-size: 13px;" %>
          </div>
        <% end %>

        <div class="text-right mb-5">
          <%= link_to "Forgot your password?", new_user_password_path, class: "text-primary-900 hover:underline", style: "font-size: 13px;" %>
        </div>

        <%= f.submit "Sign in →", class: "w-full rounded-xl font-semibold px-5 py-3 bg-primary-900 text-white hover:bg-primary-700 transition-colors cursor-pointer" %>
      <% end %>

    </div>

    <p class="text-center text-ink-muted mt-6" style="font-size: 13px;">
      New to Linguio? <%= link_to "Create an account", new_user_registration_path, class: "text-primary-900 font-medium hover:underline" %>
    </p>

  </div>
</div>