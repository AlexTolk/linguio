<div class="max-w-2xl mx-auto px-6 py-12">

  <h1 class="font-display text-4xl text-ink mb-2"><%= @lesson.title %></h1>

  <% if user_signed_in? %>
    <% if @lesson.completed_by?(current_user) %>
      <p class="mb-8 text-success-700 font-semibold" style="font-size: 14px;">
        Lesson complete — average score: <%= @lesson.score_for(current_user) %>%
      </p>
    <% else %>
      <p class="mb-8 text-ink-muted" style="font-size: 14px;">Not yet completed</p>
    <% end %>
  <% end %>

  <div class="space-y-6">
    <% @lesson.lesson_sections.each do |section| %>
      <div class="bg-white rounded-xl border border-border p-6">

        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-xl text-ink"><%= section.title %></h2>
          <% if user_signed_in? && (score = section.score_for(current_user)) %>
            <span class="text-success-700 font-semibold" style="font-size: 13px;">Section score: <%= score %>%</span>
          <% end %>
        </div>

        <div class="divide-y divide-border">
          <% section.exercises.each do |exercise| %>
            <% score = @latest_scores[exercise.id] %>
            <div class="flex items-center justify-between py-3">
              <span class="text-ink-secondary" style="font-size: 14px;"><%= exercise.exercise_type.humanize %></span>
              <div class="flex items-center gap-3">
                <% if score %>
                  <span class="text-success-700 font-semibold" style="font-size: 13px;"><%= score %>%</span>
                <% end %>
                <%= render "shared/button", text: (score ? "Review" : "Start"),
                    url: lesson_lesson_section_exercise_path(@lesson, section, exercise),
                    variant: (score ? :secondary : :primary), size: :sm %>
              </div>
            </div>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>

</div>