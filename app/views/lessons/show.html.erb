<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-3xl font-bold mb-8"><%= @lesson.title %></h1>

  <% @lesson.lesson_sections.each do |section| %>
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4"><%= section.title %></h2>

      <% section.exercises.each do |exercise| %>
        <%= render "exercises/exercise", exercise: exercise %>
      <% end %>
    </section>
  <% end %>
</div>
