<div class="max-w-2xl mx-auto px-6 py-12">

  <h1 class="font-display text-3xl text-ink mb-2">Lesson complete</h1>
  <p class="font-semibold mb-10 <%= @score && @score >= 70 ? "text-success-700" : "text-accent-700" %>">
    <%= @lesson.title %> — overall score: <%= @score %>%
  </p>

  <% @lesson.lesson_sections.order(:position).each do |section| %>
    <%= render "lesson_sections/breakdown", section: section, user: current_user %>
  <% end %>

  <div class="mt-6 flex justify-end">
    <%= render "shared/button", text: "Back to course", url: course_path(@lesson.course_section.course) %>
  </div>

</div>