<!DOCTYPE html>
<html>
  <head>
    <title>Linguio Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50">
    <nav class="bg-gray-900 text-white px-6 py-3 flex items-center gap-6">
      <%= link_to "Linguio Admin", admin_root_path, class: "font-semibold" %>
      <%= link_to "Courses", admin_courses_path, class: "text-gray-300 hover:text-white" %>
      <%= link_to "← Back to site", root_path, class: "text-gray-400 hover:text-white ml-auto text-sm" %>
    </nav>

    <main class="max-w-5xl mx-auto px-6 py-8">
      <% if notice %>
        <div class="mb-4 rounded bg-green-100 text-green-800 px-4 py-2"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>