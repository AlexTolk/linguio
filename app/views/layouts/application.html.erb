<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Linguio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Linguio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

<body class="bg-surface text-ink font-sans">
  <nav class="bg-white border-b border-border">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <%= link_to "Linguio", root_path, class: "font-display text-2xl text-primary-900" %>

      <div class="flex items-center gap-6">
        <% if user_signed_in? %>
          <div class="relative" data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center gap-2">
              <%= render "shared/avatar", user: current_user, size: :sm %>
              <span class="text-ink font-medium" style="font-size: 14px;"><%= current_user.display_name %></span>
              <svg class="text-ink-muted" viewBox="0 0 20 20" fill="currentColor" style="width: 14px; height: 14px;">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>

            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl border border-border shadow-lg py-1 z-10">
              <%= link_to "My courses", courses_path, class: "block px-4 py-2 text-ink-secondary hover:bg-surface", style: "font-size: 14px;" %>
              <%= link_to "Edit profile", edit_user_registration_path, class: "block px-4 py-2 text-ink-secondary hover:bg-surface", style: "font-size: 14px;" %>
              <div class="border-t border-border my-1"></div>
              <%= link_to "Log out",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "block px-4 py-2 text-ink-secondary hover:bg-surface", style: "font-size: 14px;" %>
            </div>
          </div>
        <% else %>
          <%= link_to "Login", new_user_session_path, class: "text-ink-secondary hover:text-primary-900 font-medium" %>
          <%= render "shared/button", text: "Sign up", url: new_user_registration_path, size: :sm %>
        <% end %>
      </div>
    </div>
  </nav>

  <main>
    <%= yield %>
  </main>

  <footer class="mt-20 py-8 text-center text-ink-muted" style="font-size: 13px;">
    © <%= Time.current.year %> Linguio
  </footer>
</body>
</html>
