<% if user_signed_in? %>

  <div class="max-w-6xl mx-auto px-6 py-12">

    <h1 class="font-display text-4xl text-ink mb-2">Welcome back</h1>
    <p class="text-ink-secondary mb-10">Pick up where you left off, or explore your courses.</p>

    <% if @focus_course.present? %>
      <%
        _, _, focus_pct = course_progress(@focus_course, current_user)
        focus_section = default_open_section(@focus_course, current_user)
      %>

      <p class="text-ink-muted font-semibold uppercase mb-3" style="font-size: 11px; letter-spacing: 0.1em;">
        <%= focus_pct == 100 ? "Completed — review any lesson" : "Continue in" %> <%= @focus_course.title %>
      </p>

      <div class="mb-10">
        <%= render "courses/section_breakdown", section: focus_section, course: @focus_course, user: current_user, index: focus_section.position, open: true %>
      </div>
    <% end %>

    <h2 class="font-display text-2xl text-ink mb-5">Your courses</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <% @courses.each do |course| %>
        <%= render "courses/course_card", course: course, user: current_user %>
      <% end %>
    </div>

  </div>

<% else %>
  <div class="bg-white border-b border-border">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <p class="text-primary-900 font-semibold uppercase" style="font-size: 12px; letter-spacing: 0.12em;">
        French Language Learning
      </p>
      <h1 class="font-display text-5xl text-ink leading-tight mt-4">
        Build real French fluency, one structured lesson at a time.
      </h1>
      <p class="mt-6 text-lg text-ink-secondary leading-relaxed max-w-2xl mx-auto">
        Linguio combines systematic vocabulary, grammar, and interactive exercises to prepare you for the TEF Canada and TCF Canada exams — with the clarity of a textbook and the engagement of a modern app.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <%= render "shared/button", text: "Get started", url: new_user_registration_path, size: :lg %>
        <%= render "shared/button", text: "Log in", url: new_user_session_path, variant: :secondary, size: :lg %>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-display text-xl text-ink mb-2">Structured, not random</h3>
        <p class="text-ink-secondary text-sm leading-relaxed">Every lesson builds on the last — vocabulary, grammar, and practice are sequenced deliberately, not scattered.</p>
      </div>
      <div>
        <h3 class="font-display text-xl text-ink mb-2">Exam-focused</h3>
        <p class="text-ink-secondary text-sm leading-relaxed">Built around TEF Canada and TCF Canada requirements, so your study time translates directly to exam readiness.</p>
      </div>
      <div>
        <h3 class="font-display text-xl text-ink mb-2">No gimmicks</h3>
        <p class="text-ink-secondary text-sm leading-relaxed">No streaks, no hearts, no XP grind — just clear progress toward real fluency.</p>
      </div>
    </div>
  </div>
<% end %>