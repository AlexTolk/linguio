<%# Locals: section: [CourseSection], course: [Course], user: [User], index: [Integer], open: [Boolean] %>
<%
  lessons = section.lessons.order(:position)
  completed_count = lessons.count { |l| l.completed_by?(user) }
  total_count = lessons.size
  pct = total_count.zero? ? 0 : ((completed_count.to_f / total_count) * 100).round
%>
<details class="group bg-white rounded-xl border border-border" <%= "open" if open %>>

  <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none">
    <div class="flex items-center gap-3">
      <div class="flex items-center justify-center rounded-full bg-primary-900 text-white font-bold shrink-0" style="width: 28px; height: 28px; font-size: 13px;">
        <%= index %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="font-display text-xl text-ink"><%= section.title %></h2>
          <%= render "shared/level_badge", level: course.level %>
        </div>
        <p class="text-ink-muted" style="font-size: 13px;">
          <%= completed_count %> of <%= total_count %> lessons complete
        </p>
      </div>
    </div>

    <div class="flex items-center gap-4 shrink-0">
      <div style="width: 100px;">
        <div class="flex justify-end text-ink-muted mb-1" style="font-size: 12px;">
          <span><%= completed_count %>/<%= total_count %></span>
        </div>
        <div class="rounded-full overflow-hidden bg-surface border border-border" style="height: 6px;">
          <div class="h-full bg-primary-900 rounded-full" style="width: <%= pct %>%;"></div>
        </div>
      </div>
      <svg class="text-ink-muted transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" style="width: 16px; height: 16px;">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </div>
  </summary>

  <div class="border-t border-border">
    <% lessons.each_with_index do |lesson, i| %>
      <%
        state = lesson_state(lesson, user)
        score = lesson.score_for(user)
      %>

      <div class="flex items-center justify-between gap-4 px-6 py-4 <%= "border-b border-border" unless lesson == lessons.last %>">
        <div class="flex items-center gap-3 min-w-0">
          <% if state == :completed %>
            <div class="flex items-center justify-center rounded-full bg-success-100 text-success-700 shrink-0" style="width: 26px; height: 26px;">
              <svg viewBox="0 0 20 20" fill="currentColor" style="width: 13px; height: 13px;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
          <% elsif state == :in_progress %>
            <div class="flex items-center justify-center rounded-full border-2 border-primary-900 text-primary-900 font-bold shrink-0" style="width: 26px; height: 26px; font-size: 12px;">
              <%= i + 1 %>
            </div>
          <% else %>
            <div class="flex items-center justify-center rounded-full bg-surface text-ink-muted font-bold shrink-0" style="width: 26px; height: 26px; font-size: 12px;">
              <%= i + 1 %>
            </div>
          <% end %>

          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <%= link_to lesson.title, lesson_path(lesson), class: "font-semibold text-ink hover:text-primary-900" %>
              <% if state == :in_progress %>
                <span class="inline-block font-semibold rounded-full bg-primary-100 text-primary-900 uppercase" style="font-size: 10px; padding: 2px 8px; letter-spacing: 0.05em;">
                  In progress
                </span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <% if state == :completed && score.present? %>
            <span class="text-success-700 font-semibold" style="font-size: 14px;"><%= score %>%</span>
          <% end %>
          <%= render "shared/button", text: lesson_button_text(state), url: lesson_path(lesson), variant: lesson_button_variant(state), size: :sm %>
        </div>
      </div>

    <% end %>
  </div>

</details>