<div class="max-w-6xl mx-auto px-6 py-12">

  <h1 class="font-display text-4xl text-ink mb-10">
    French Courses
  </h1>

  <div class="grid md:grid-cols-3 gap-6">
    <% @courses.each do |course| %>
      <%= render "courses/course_card", course: course, user: current_user %>
    <% end %>
  </div>

</div>