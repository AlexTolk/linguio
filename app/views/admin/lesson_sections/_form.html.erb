<%= form_with model: [:admin, lesson, lesson_section], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if lesson_section.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% lesson_section.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium" %>
    <%= f.text_field :title, class: "mt-1 block w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :section_type, class: "block text-sm font-medium" %>
    <%= f.text_field :section_type, placeholder: "e.g. vocabulary, grammar", class: "mt-1 block w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :position, class: "block text-sm font-medium" %>
    <%= f.number_field :position, class: "mt-1 block w-32 border rounded px-3 py-2" %>
  </div>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>