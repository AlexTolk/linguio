<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="text-2xl font-bold"><%= @lesson_section.title %></h1>
    <p class="text-gray-500"><%= @lesson.title %> · <%= @lesson_section.section_type %></p>
  </div>
  <%= link_to "Edit", edit_admin_lesson_lesson_section_path(@lesson, @lesson_section), class: "text-blue-600" %>
</div>

<div class="flex justify-between items-center mb-2">
  <h2 class="text-lg font-semibold">Exercises</h2>
  <%= link_to "New Exercise", new_admin_lesson_section_exercise_path(@lesson_section), class: "text-sm bg-blue-600 text-white px-3 py-1.5 rounded" %>
</div>

<div class="bg-white rounded shadow-sm divide-y">
  <% @lesson_section.exercises.order(:position).each do |exercise| %>
    ...
  <% end %>
</div>