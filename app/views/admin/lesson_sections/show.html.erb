<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="text-2xl font-bold"><%= @lesson_section.title %></h1>
    <p class="text-gray-500"><%= @lesson.title %> · <%= @lesson_section.section_type %></p>
  </div>
  <%= link_to "Edit", edit_admin_lesson_lesson_section_path(@lesson, @lesson_section), class: "text-blue-600" %>
</div>

<div class="flex justify-between items-center mb-2">
  <h2 class="text-lg font-semibold">Exercises</h2>
  <%= link_to "New Exercise", new_admin_lesson_section_exercise_path(@lesson_section), class: "text-sm bg-blue-600 text-white px-3 py-1.5 rounded" %>
</div>

<div class="bg-white rounded shadow-sm divide-y">
  <% @lesson_section.exercises.order(:position).each do |exercise| %>
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-2xl font-bold"><%= @lesson_section.title %></h1>
        <p class="text-gray-500"><%= @lesson.title %> · <%= @lesson_section.section_type %></p>
      </div>
      <%= link_to "Edit", edit_admin_lesson_lesson_section_path(@lesson, @lesson_section), class: "text-blue-600" %>
    </div>

    <div class="flex justify-between items-center mb-2">
      <h2 class="text-lg font-semibold">Exercises</h2>
      <%= link_to "New Exercise", new_admin_lesson_section_exercise_path(@lesson_section), class: "text-sm bg-blue-600 text-white px-3 py-1.5 rounded" %>
    </div>

    <div class="bg-white rounded shadow-sm divide-y">
      <% @lesson_section.exercises.order(:position).each do |exercise| %>
        <div class="px-4 py-3 flex justify-between items-center">
          <div>
            <span class="text-gray-400 text-sm mr-2">#<%= exercise.position %></span>
            <%= link_to exercise.exercise_type, admin_lesson_section_exercise_path(@lesson_section, exercise), class: "text-gray-700 hover:text-blue-600" %>
          </div>
          <div class="space-x-2">
            <%= link_to "Edit", edit_admin_lesson_section_exercise_path(@lesson_section, exercise), class: "text-blue-600 text-sm" %>
            <%= button_to "Delete", admin_lesson_section_exercise_path(@lesson_section, exercise), method: :delete,
                  data: { turbo_confirm: "Delete this exercise?" },
                  class: "text-red-600 text-sm inline" %>
          </div>
        </div>
      <% end %>
      <% if @lesson_section.exercises.empty? %>
        <div class="px-4 py-3 text-gray-400 text-sm">No exercises yet.</div>
      <% end %>
    </div>
  <% end %>
</div>