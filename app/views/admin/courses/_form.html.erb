<%= form_with model: [:admin, course], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if course.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% course.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium" %>
    <%= f.text_field :title, class: "mt-1 block w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 block w-full border rounded px-3 py-2" %>
  </div>

  <div class="flex gap-4">
    <div>
      <%= f.label :language, class: "block text-sm font-medium" %>
      <%= f.select :language, [["French", "fr"], ["Russian", "ru"]], {}, class: "mt-1 border rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :level, class: "block text-sm font-medium" %>
      <%= f.text_field :level, placeholder: "e.g. A1, B2", class: "mt-1 border rounded px-3 py-2" %>
    </div>
  </div>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>