<%= form_with model: [:admin, lesson_section, exercise], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if exercise.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% exercise.errors.full_messages.each { |msg| %><li><%= msg %></li><% } %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :exercise_type %>

  <div>
    <%= f.label :position, class: "block text-sm font-medium" %>
    <%= f.number_field :position, class: "mt-1 block w-32 border rounded px-3 py-2" %>
  </div>

  <fieldset class="border rounded p-4">
    <legend class="text-sm font-medium px-1">Lines</legend>
    <p class="text-xs text-gray-400 mb-2">
      Pick "Shown" for a line that's just displayed, or "Choice" to make the user pick the correct reply.
      Leave a row's speaker and text/options blank to skip it.
    </p>

    <div class="space-y-4">
      <% Admin::ExercisesController::DIALOGUE_ROWS.times do |i| %>
        <% line = exercise.content.dig("lines", i) || {} %>
        <% type = line["type"] || "shown" %>
        <% options = line["options"] || [] %>
        <% option_a = options[0] || {} %>
        <% option_b = options[1] || {} %>
        <% correct_index = options.find_index { |o| o["correct"] } %>

        <div class="border-t pt-3 first:border-t-0 first:pt-0 space-y-2">
          <div class="flex gap-2">
            <%= select_tag "exercise[content][lines][#{i}][type]",
                  options_for_select([["Shown", "shown"], ["Choice", "choice"]], type),
                  class: "border rounded px-3 py-2 w-32" %>
            <%= text_field_tag "exercise[content][lines][#{i}][speaker]", line["speaker"],
                  placeholder: "Speaker", class: "block w-1/3 border rounded px-3 py-2" %>
          </div>

          <div class="pl-2 border-l-2 border-gray-100 space-y-1">
            <p class="text-xs text-gray-400">Shown text (used if type = Shown)</p>
            <div class="flex gap-2">
              <%= text_field_tag "exercise[content][lines][#{i}][text]", line["text"],
                    placeholder: "French line", class: "block w-1/2 border rounded px-3 py-2" %>
              <%= text_field_tag "exercise[content][lines][#{i}][translation]", line["translation"],
                    placeholder: "English translation", class: "block w-1/2 border rounded px-3 py-2" %>
            </div>
          </div>

          <div class="pl-2 border-l-2 border-gray-100 space-y-1">
            <p class="text-xs text-gray-400">Choice options (used if type = Choice)</p>

            <div class="flex gap-2 items-center">
              <%= radio_button_tag "exercise[content][lines][#{i}][correct_option]", "a", correct_index == 0 %>
              <%= text_field_tag "exercise[content][lines][#{i}][option_a_text]", option_a["text"],
                    placeholder: "Option A (correct?)", class: "block w-1/2 border rounded px-3 py-2" %>
              <%= text_field_tag "exercise[content][lines][#{i}][option_a_translation]", option_a["translation"],
                    placeholder: "Option A translation", class: "block w-1/2 border rounded px-3 py-2" %>
            </div>

            <div class="flex gap-2 items-center">
              <%= radio_button_tag "exercise[content][lines][#{i}][correct_option]", "b", correct_index == 1 %>
              <%= text_field_tag "exercise[content][lines][#{i}][option_b_text]", option_b["text"],
                    placeholder: "Option B (correct?)", class: "block w-1/2 border rounded px-3 py-2" %>
              <%= text_field_tag "exercise[content][lines][#{i}][option_b_translation]", option_b["translation"],
                    placeholder: "Option B translation", class: "block w-1/2 border rounded px-3 py-2" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>