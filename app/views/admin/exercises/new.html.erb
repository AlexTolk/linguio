<% if @exercise.exercise_type.blank? %>
  <h1 class="text-2xl font-bold mb-6">New Exercise — <%= @lesson_section.title %></h1>

  <%= form_with url: new_admin_lesson_section_exercise_path(@lesson_section), method: :get,
        class: "space-y-4 bg-white p-6 rounded shadow-sm max-w-sm" do %>
    <div>
      <%= label_tag :exercise_type, "Exercise type", class: "block text-sm font-medium" %>
      <%= select_tag :exercise_type, options_for_select(Admin::ExercisesController::EXERCISE_TYPES),
            class: "mt-1 block w-full border rounded px-3 py-2" %>
    </div>
    <%= submit_tag "Continue", class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
  <% end %>
<% else %>
  <h1 class="text-2xl font-bold mb-6">New <%= @exercise.exercise_type.humanize %> Exercise — <%= @lesson_section.title %></h1>
  <%= render "#{@exercise.exercise_type}_form", lesson_section: @lesson_section, exercise: @exercise %>
<% end %>