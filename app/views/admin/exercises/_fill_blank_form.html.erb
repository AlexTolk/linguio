<%= form_with model: [:admin, lesson_section, exercise], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if exercise.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% exercise.errors.full_messages.each { |msg| %><li><%= msg %></li><% } %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :exercise_type %>

  <div>
    <%= f.label :position, class: "block text-sm font-medium" %>
    <%= f.number_field :position, class: "mt-1 block w-32 border rounded px-3 py-2" %>
  </div>

  <fieldset class="border rounded p-4">
    <legend class="text-sm font-medium px-1">Questions</legend>
    <p class="text-xs text-gray-400 mb-2">Leave sentence and answer blank to skip a row. Separate alternative answers with commas.</p>

    <div class="space-y-4">
      <% Admin::ExercisesController::FILL_BLANK_ROWS.times do |i| %>
        <% q = exercise.content.dig("questions", i) || {} %>
        <div class="border-t pt-3 first:border-t-0 first:pt-0 space-y-2">
          <%= text_field_tag "exercise[content][questions][#{i}][sentence]", q["sentence"],
                placeholder: "Sentence with ___ blank", class: "block w-full border rounded px-3 py-2" %>
          <div class="flex gap-2">
            <%= text_field_tag "exercise[content][questions][#{i}][answer]", q["answer"],
                  placeholder: "Answer", class: "block w-1/3 border rounded px-3 py-2" %>
            <%= text_field_tag "exercise[content][questions][#{i}][alternatives]", Array(q["alternatives"]).join(", "),
                  placeholder: "Alternatives (comma-separated)", class: "block w-1/3 border rounded px-3 py-2" %>
            <%= text_field_tag "exercise[content][questions][#{i}][hint]", q["hint"],
                  placeholder: "Hint", class: "block w-1/3 border rounded px-3 py-2" %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>