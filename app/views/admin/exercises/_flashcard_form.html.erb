<%= form_with model: [:admin, lesson_section, exercise], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if exercise.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% exercise.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :exercise_type %>

  <div>
    <%= f.label :position, class: "block text-sm font-medium" %>
    <%= f.number_field :position, class: "mt-1 block w-32 border rounded px-3 py-2" %>
  </div>

  <fieldset class="border rounded p-4 space-y-2">
    <legend class="text-sm font-medium px-1">Front</legend>
    <%= label_tag "content_front_word", "Word", class: "block text-xs text-gray-500" %>
    <%= text_field_tag "exercise[content][front][word]",
          exercise.content.dig("front", "word"),
          id: "content_front_word",
          class: "block w-full border rounded px-3 py-2" %>
  </fieldset>

  <fieldset class="border rounded p-4 space-y-2">
    <legend class="text-sm font-medium px-1">Back</legend>

    <%= label_tag "content_back_translation", "Translation", class: "block text-xs text-gray-500" %>
    <%= text_field_tag "exercise[content][back][translation]",
          exercise.content.dig("back", "translation"),
          id: "content_back_translation",
          class: "block w-full border rounded px-3 py-2" %>

    <%= label_tag "content_back_example", "Example sentence", class: "block text-xs text-gray-500 mt-2" %>
    <%= text_area_tag "exercise[content][back][example]",
          exercise.content.dig("back", "example"),
          id: "content_back_example",
          rows: 2,
          class: "block w-full border rounded px-3 py-2" %>
  </fieldset>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>