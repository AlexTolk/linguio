<%= form_with model: [:admin, lesson_section, exercise], class: "space-y-4 bg-white p-6 rounded shadow-sm" do |f| %>
  <% if exercise.errors.any? %>
    <div class="bg-red-50 text-red-700 px-4 py-2 rounded">
      <ul>
        <% exercise.errors.full_messages.each { |msg| %><li><%= msg %></li><% } %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :exercise_type %>

  <div>
    <%= f.label :position, class: "block text-sm font-medium" %>
    <%= f.number_field :position, class: "mt-1 block w-32 border rounded px-3 py-2" %>
  </div>

  <fieldset class="border rounded p-4">
    <legend class="text-sm font-medium px-1">Pairs</legend>
    <p class="text-xs text-gray-400 mb-2">Leave both fields blank to skip a row.</p>

    <div class="space-y-2">
      <% Admin::ExercisesController::MATCHING_ROWS.times do |i| %>
        <% pair = exercise.content.dig("pairs", i) || {} %>
        <div class="flex gap-2">
          <%= text_field_tag "exercise[content][pairs][#{i}][left]", pair["left"],
                placeholder: "French", class: "block w-1/2 border rounded px-3 py-2" %>
          <%= text_field_tag "exercise[content][pairs][#{i}][right]", pair["right"],
                placeholder: "English", class: "block w-1/2 border rounded px-3 py-2" %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <%= f.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer" %>
<% end %>
