<div class="space-y-6">
  <% questions = exercise.content["questions"].each_with_index.to_a %>
  <% questions = questions.select { |_q, i| item_keys.include?(i.to_s) } if local_assigns[:review_mode] %>

  <%= form_with url: (local_assigns[:review_mode] ?
        submit_review_lesson_lesson_section_exercise_path(lesson, lesson_section, exercise) :
        submit_lesson_lesson_section_exercise_path(lesson, lesson_section, exercise)) do %>
    <% questions.each do |q, i| %>
      <div class="mb-4">
        <p class="font-medium mb-1"><%= q["sentence"] %></p>
        <% if q["hint"].present? %>
          <p class="text-sm text-gray-400 mb-1"><%= q["hint"] %></p>
        <% end %>
        <%= text_field_tag "answers[#{i}]", nil, class: "border rounded-md px-3 py-1", autocomplete: "off" %>
      </div>
    <% end %>

    <button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 text-white font-medium hover:bg-indigo-700">
      <%= local_assigns[:review_mode] ? "Submit review" : "Submit" %>
    </button>
  <% end %>
</div>