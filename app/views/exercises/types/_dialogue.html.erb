<div data-controller="dialogue">
  <%= form_with url: submit_lesson_lesson_section_exercise_path(lesson, lesson_section, exercise) do %>
    <div class="space-y-4">
      <% exercise.content["lines"].each_with_index do |line, i| %>
        <%
          has_options = line["options"].present?
          speaker_initials = line["speaker"].to_s.split.map { |w| w[0] }.first(2).join.upcase
        %>

        <% if has_options %>
          <%# Learner's turn — left side, real user identity %>
          <div data-dialogue-target="line" data-index="<%= i %>" data-has-options="true"
               class="hidden opacity-0 translate-y-2 transition-all duration-300 ease-out flex items-start gap-3">

            <%= render "shared/avatar", user: current_user, size: :sm %>

            <div class="max-w-[75%]">
              <p class="text-ink-muted font-medium mb-1.5" style="font-size: 11px;"><%= current_user.display_name %></p>
              <div class="space-y-1.5">
                <% line["options"].each_with_index do |option, opt_index| %>
                  <label class="block rounded-2xl border border-border bg-white px-4 py-2 cursor-pointer transition-colors hover:border-border-strong has-[:checked]:border-primary-900 has-[:checked]:bg-primary-900 has-[:checked]:text-white">
                    <%= radio_button_tag "choices[#{i}]", opt_index, false,
                          class: "hidden", data: { action: "change->dialogue#choose" } %>
                    <span style="font-size: 14px;"><%= option["text"] %></span>
                  </label>
                <% end %>
              </div>
            </div>

          </div>
        <% else %>
          <%# Context line — right side, incoming %>
          <div data-dialogue-target="line" data-index="<%= i %>" data-has-options="false"
               class="hidden opacity-0 translate-y-2 transition-all duration-300 ease-out flex items-start gap-3 justify-end">

            <div class="max-w-[75%] text-right">
              <p class="text-ink-muted font-medium mb-1.5" style="font-size: 11px;"><%= line["speaker"] %></p>
              <div class="inline-block rounded-2xl bg-surface border border-border px-4 py-2 text-left">
                <span class="text-ink" style="font-size: 14px;"><%= line["text"] %></span>
              </div>
            </div>

            <div class="flex items-center justify-center rounded-full bg-border text-ink-muted font-semibold shrink-0" style="width: 28px; height: 28px; font-size: 11px;">
              <%= speaker_initials %>
            </div>

          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-8 flex justify-end">
      <button type="submit" data-dialogue-target="submit"
              class="hidden rounded-xl font-semibold px-5 py-3 bg-primary-900 text-white hover:bg-primary-700 transition-colors">
        Submit
      </button>
    </div>
  <% end %>
</div>